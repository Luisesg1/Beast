# Plantilla de variables de entorno. Copia a `.env` y rellena con tus valores.
# Las VITE_* se inyectan en el bundle del cliente (son públicas por diseño).

# ── Firebase (Project Settings > General > Tus apps > Configuración SDK) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Analytics. Habilita Google Analytics en la consola de Firebase y
# copia aquí el measurementId (G-XXXXXXXXXX). Sin esto, la telemetría queda
# desactivada de forma segura (no rompe nada).
VITE_FIREBASE_MEASUREMENT_ID=

# ── RevenueCat (SDK public keys — empiezan por goog_ / appl_) ──
VITE_RC_API_KEY_ANDROID=
VITE_RC_API_KEY_IOS=
